# Django core
DJANGO_SECRET_KEY=replace-with-your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL=False
SITE_URL=http://127.0.0.1:8000

# Database
# For local PostgreSQL example:
DATABASE_URL=postgresql://dentoria:dentoria_dev_password@localhost:5432/dentoria
POSTGRES_DB=dentoria
POSTGRES_USER=dentoria
POSTGRES_PASSWORD=dentoria_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email
# Use console backend for local development to print activation links in terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-email-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Dentoria <noreply@example.com>

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
